# Google Sheets Integration Configuration
# Set these in your local environment (.env.local) or in Vercel Project Settings -> Environment Variables

# 1. Google Cloud Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 2. Google Cloud Service Account Private Key (with \n for line breaks)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...==\n-----END PRIVATE KEY-----\n"

# 3. Target Google Sheet ID (from sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# 4. Feature Flags (Deployment / Testing / Production Controls)
# - SKIP_TIMER: Set to "true" to skip / bypass the 21s / 30s focus timers.
# - SKIP_REQUIRED: Set to "true" to make all questions optional and allow proceeding without filling all fields.
SKIP_TIMER=false
NEXT_PUBLIC_SKIP_TIMER=false
SKIP_REQUIRED=false
NEXT_PUBLIC_SKIP_REQUIRED=false
