{
  "meta": {
    "title": {
      "en": "Frontal Smile Assessment Questionnaire",
      "ar": "استبيان تقييم الابتسامة من المنظور الأمامي"
    },
    "subtitle": {
      "en": "A scientific study on aesthetic smile perception",
      "ar": "دراسة علمية حول إدراك جماليات الابتسامة"
    },
    "photoRatingInstruction": {
      "en": "Rate the smile attractiveness, using the scale below the photo where 10 = least attractive going to 100 = most attractive.",
      "ar": "قيّم مدى جاذبية الابتسامة باستخدام المقياس أسفل الصورة، حيث يمثل الرقم 10 الأقل جاذبية والرقم 100 الأكثر جاذبية."
    },
    "photoRankingInstruction": {
      "en": "Rank the following smiles according to your personal preference, from the most preferred to the least preferred. Click the photos one by one, starting with your first choice.",
      "ar": "رتّب الابتسامات التالية حسب تفضيلك الشخصي، من الأكثر تفضيلاً إلى الأقل تفضيلاً. اضغط على الصور واحدة تلو الأخرى، بدءاً باختيارك الأول."
    }
  },
  "pages": [
    {
      "id": "page1",
      "title": {
        "en": "Demographic & Background Information",
        "ar": "المعلومات الشخصية والمهنية"
      },
      "description": {
        "en": "Please provide your general background information before proceeding to the smile evaluation.",
        "ar": "يرجى تقديم معلوماتك العامة قبل الانتقال إلى تقييم الابتسامات."
      },
      "questions": [
        {
          "id": "name",
          "type": "short_text",
          "required": true,
          "minLength": 3,
          "maxLength": 30,
          "label": {
            "en": "Full Name",
            "ar": "الاسم بالكامل"
          },
          "placeholder": {
            "en": "Enter your name (min 3 characters)",
            "ar": "أدخل اسمك (3 أحرف على الأقل)"
          }
        },
        {
          "id": "gender",
          "type": "single_choice",
          "required": true,
          "label": {
            "en": "Gender",
            "ar": "الجنس"
          },
          "options": [
            {
              "value": "male",
              "label": {
                "en": "Male",
                "ar": "ذكر"
              }
            },
            {
              "value": "female",
              "label": {
                "en": "Female",
                "ar": "أنثى"
              }
            }
          ]
        },
        {
          "id": "age_group",
          "type": "single_choice",
          "required": true,
          "label": {
            "en": "Age Group",
            "ar": "الفئة العمرية"
          },
          "options": [
            {
              "value": "18_24",
              "label": {
                "en": "18 to 24 years old",
                "ar": "من 18 إلى 24 سنة"
              }
            },
            {
              "value": "25_34",
              "label": {
                "en": "25 to 34 years old",
                "ar": "من 25 إلى 34 سنة"
              }
            },
            {
              "value": "35_45",
              "label": {
                "en": "35 to 45 years old",
                "ar": "من 35 إلى 45 سنة"
              }
            },
            {
              "value": "over_45",
              "label": {
                "en": "Older than 45",
                "ar": "أكثر من 45 سنة"
              }
            }
          ]
        },
        {
          "id": "occupation",
          "type": "single_choice",
          "required": true,
          "label": {
            "en": "Occupation",
            "ar": "المهنة"
          },
          "options": [
            {
              "value": "orthodontist",
              "label": {
                "en": "Orthodontist",
                "ar": "أخصائي تقويم أسنان"
              }
            },
            {
              "value": "dentist",
              "label": {
                "en": "Dentist",
                "ar": "طبيب أسنان"
              }
            },
            {
              "value": "non_dental",
              "label": {
                "en": "Non-dental profession",
                "ar": "مهنة غير متعلقة بطب الأسنان"
              }
            }
          ]
        },
        {
          "id": "work_experience",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 60,
          "label": {
            "en": "Years of work experience",
            "ar": "عدد سنوات الخبرة العملية"
          },
          "placeholder": {
            "en": "e.g. 5",
            "ar": "مثال: 5"
          },
          "showIf": {
            "question": "occupation",
            "in": ["orthodontist", "dentist"]
          }
        }
      ]
    },
    {
      "id": "page2",
      "title": {
        "en": "Smile Rating (Set 1)",
        "ar": "تقييم الابتسامات (المجموعة الأولى)"
      },
      "description": {
        "en": "Tip: You can maximize any photo to full screen using the button in its top-right corner.",
        "ar": "تلميح: يمكنك تكبير أي صورة لعرضها بالشاشة الكاملة باستخدام الزر الموجود في الزاوية العلوية للصورة."
      },
      "questions": [
        {
          "id": "R01",
          "type": "photo_rating",
          "required": true,
          "instruction": {
            "en": "You can click the button in the top-right corner of the photo to maximize its size.",
            "ar": "يمكنك الضغط على الزر في الزاوية العلوية للصورة لتكبير حجمها وعرضها بالشاشة الكاملة."
          },
          "photo": {
            "id": "straight-0",
            "src": "/photos/straight-0.jpg"
          },
          "min": 10,
          "max": 100,
          "step": 10
        },
